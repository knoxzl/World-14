cmd-planet14_planet-desc = Generates a new planet map from a Planet 14 YAML recipe.
cmd-planet14_planet-help = Usage: planet14_planet <prototype> [non-negative seed]
planet14-planet-prototype-hint = Planet recipe
planet14-planet-seed-invalid = The seed must be a whole number between 0 and 2147483647.
planet14-planet-unknown = Unknown planet recipe or biome: {$prototype}.
planet14-planet-invalid = Invalid settings in {$prototype}. Check the seed and day/night duration and light levels.
planet14-planet-created = Generated {$name} on map {$map}. Use mapping or teleport tools to visit it.
planet14-planet-failed = Planet generation failed. Check the server log. The incomplete map will be removed.
